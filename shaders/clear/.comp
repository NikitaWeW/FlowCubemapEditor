#version 440

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba16f, binding = 0) uniform imageCube u_output;
uniform bool u_hdrFlowMap;

void main() 
{
    ivec3 coords = ivec3(gl_GlobalInvocationID.xyz);
    vec4 clearColor = u_hdrFlowMap ? vec4(0) : vec4(0.5, 0.5, 0, 0);
    imageStore(u_output, coords, clearColor);
}