#version 440

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba16f, binding = 0) uniform imageCube u_back;
layout(rgba16f, binding = 1) uniform imageCube u_front;
layout(rgba16f, binding = 2) uniform imageCube u_output;

uniform bool horizontal;
uniform float weight[5] = float[] (0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);

void main()
{
    vec4 back  = imageLoad(u_back,  ivec3(gl_GlobalInvocationID.xyz));
    vec4 front = imageLoad(u_front, ivec3(gl_GlobalInvocationID.xyz));

    imageStore(u_output, ivec3(gl_GlobalInvocationID.xyz), vec4(mix(back.rgb, front.rgb, front.a), 1));
}