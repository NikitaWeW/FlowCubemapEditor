#version 440

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform imageCube u_image;

vec4 sampleOffset(imageCube cube, ivec2 offset)
{
    return imageLoad(cube, ivec3(gl_GlobalInvocationID.xy + offset, gl_GlobalInvocationID.z));
}

const ivec2 offsets[25] = ivec2[](
    ivec2(-2, -2), ivec2(-1, -2), ivec2( 0, -2), ivec2( 1, -2), ivec2( 2, -2),
    ivec2(-2, -1), ivec2(-1, -1), ivec2( 0, -1), ivec2( 1, -1), ivec2( 2, -1),
    ivec2(-2,  0), ivec2(-1,  0), ivec2( 0,  0), ivec2( 1,  0), ivec2( 2,  0),
    ivec2(-2,  1), ivec2(-1,  1), ivec2( 0,  1), ivec2( 1,  1), ivec2( 2,  1),
    ivec2(-2,  2), ivec2(-1,  2), ivec2( 0,  2), ivec2( 1,  2), ivec2( 2,  2)
);

void main()
{
    vec4 color = vec4(0);
    for(int i = 0; i < offsets.length(); ++i)
        color += sampleOffset(u_image, offsets[i]);
    color /= offsets.length();

    imageStore(u_image, ivec3(gl_GlobalInvocationID.xyz), vec4(color.rgb, float(color.a != 0)));
}