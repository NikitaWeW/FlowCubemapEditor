#version 440

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0) uniform samplerCube u_input;
layout(rgba16f, binding = 1) uniform imageCube u_output;

uniform bool u_horizontal;
uniform float u_time = 1;

uint seed = 0;


uint rand(inout uint state) {
	state = state * 747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}
float randZeroOne(inout uint state) {
    return float(rand(state)) * (1.0 / float(0xffffffffu));
}
float randNormalDistribution(inout uint state) {
    // Thanks to https://stackoverflow.com/a/6178290
    float theta = 2 * 3.1415926 * randZeroOne(state);
    float rho = sqrt(-2 * log(randZeroOne(state)));
    return rho * cos(theta);
}
vec3 randUnitSphere(inout uint state) {
    return normalize(vec3(randNormalDistribution(state) * 2 - 1, randNormalDistribution(state) * 2 - 1, randNormalDistribution(state))) * 2 - 1;
}
vec3 randHemisphere(inout uint state, vec3 normal) {
    vec3 randSphere = randUnitSphere(state);

    if(dot(normal, randSphere) < 0) return -randSphere;
    return randSphere;
}

const vec3 gridSamplingDisk[20] = vec3[]
(
   vec3(1, 1,  1), vec3( 1, -1,  1), vec3(-1, -1,  1), vec3(-1, 1,  1), 
   vec3(1, 1, -1), vec3( 1, -1, -1), vec3(-1, -1, -1), vec3(-1, 1, -1),
   vec3(1, 1,  0), vec3( 1, -1,  0), vec3(-1, -1,  0), vec3(-1, 1,  0),
   vec3(1, 0,  1), vec3(-1,  0,  1), vec3( 1,  0, -1), vec3(-1, 0, -1),
   vec3(0, 1,  1), vec3( 0, -1,  1), vec3( 0, -1, -1), vec3( 0, 1, -1)
);
vec4 boxBlur(samplerCube cube, vec3 dir, float diskRadius)
{
    dir = normalize(dir);
    vec4 res = vec4(0);
    for(int i = 0; i < gridSamplingDisk.length(); ++i)
    {
        res += texture(cube, dir + normalize(gridSamplingDisk[i] + randHemisphere(seed, dir) * diskRadius * 0.2) * diskRadius);
    }
    res /= float(gridSamplingDisk.length());

    return res;
}

const float weight[5] = float[] (0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);
vec4 gaussianBlur(samplerCube cube, vec3 dir, bool horizontal, float radius)
{
    dir = normalize(dir);
    vec3 worldUp = dot(dir, vec3(0, 1, 0)) > 0.99 ? vec3(1, 0, 0) : vec3(0, 1, 0);
    vec3 right = normalize(cross(dir, worldUp));

    vec4 gaussian = texture(cube, dir) * weight[0];
    if(horizontal)
    {
        for(int i = 1; i < weight.length(); ++i)
        {
            gaussian += texture(cube, dir + randHemisphere(seed, dir) * radius * 0.3 + radius * right * i) * weight[i];
            gaussian += texture(cube, dir - randHemisphere(seed, dir) * radius * 0.3 - radius * right * i) * weight[i];
        }
    }
    else
    { 
        vec3 up = normalize(cross(right, dir));

        for(int i = 1; i < weight.length(); ++i)
        {
            gaussian += texture(cube, dir + randHemisphere(seed, dir) * radius * 0.3 + radius * up * i) * weight[i];
            gaussian += texture(cube, dir - randHemisphere(seed, dir) * radius * 0.3 - radius * up * i) * weight[i];
        }
    }

    return gaussian;
}
// thanks to https://github.com/Nadrin/PBR/blob/master/data/shaders/glsl/equirect2cube_cs.glsl
vec3 getSamplingPoint()
{
    vec2 st = gl_GlobalInvocationID.xy / vec2(imageSize(u_output));
    vec2 uv = 2.0 * vec2(st.x, 1.0-st.y) - vec2(1.0);

    vec3 ret = vec3(1);
	// Select vector based on cubemap face index.
    // Sadly 'switch' doesn't seem to work, at least on NVIDIA.
         if(gl_GlobalInvocationID.z == 0) ret = vec3(  1.0, uv.y, -uv.x);
    else if(gl_GlobalInvocationID.z == 1) ret = vec3( -1.0, uv.y, uv.x);
    else if(gl_GlobalInvocationID.z == 2) ret = vec3( uv.x,  1.0,-uv.y);
    else if(gl_GlobalInvocationID.z == 3) ret = vec3( uv.x, -1.0, uv.y);
    else if(gl_GlobalInvocationID.z == 4) ret = vec3( uv.x, uv.y, 1.0);
    else if(gl_GlobalInvocationID.z == 5) ret = vec3(-uv.x, uv.y, -1.0);
    return ret;
}

void main()
{
    vec3 dir = normalize(getSamplingPoint());

    ivec3 texelCoord = ivec3(gl_GlobalInvocationID.xyz);
    vec2 numTexels = gl_NumWorkGroups.xy*gl_WorkGroupSize.xy;
    float pixelIndex = texelCoord.y + (numTexels.x + numTexels.y) * texelCoord.x + (numTexels.x + numTexels.y + 6) * texelCoord.z;
    seed = uint(u_time * pixelIndex);

    vec4 color1 = gaussianBlur(u_input, dir, u_horizontal, 0.01);
    vec4 color2 = boxBlur(u_input, dir, 0.01);

    vec4 color = mix(color1, color2, 0.5);

    imageStore(u_output, ivec3(gl_GlobalInvocationID.xyz), vec4(color.rgb, float(color.a != 0)));
}